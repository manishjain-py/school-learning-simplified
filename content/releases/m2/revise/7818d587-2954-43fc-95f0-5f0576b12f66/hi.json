      "question": {
        "display": "Seasons किस वजह से आते हैं?",
        "audioUrl": "/media/9a6e5700961df3ce644a52cf0909fd5d2eab69d16499c2720b72ee8af967e331.mp3",
        "audioSha256": "9a6e5700961df3ce644a52cf0909fd5d2eab69d16499c2720b72ee8af967e331"
      },
      "answer": {
        "display": "Earth का Sun के चारों ओर चक्कर, और उसकी tilted axis, दोनों।",
        "audioUrl": "/media/5ca014f4ea58b4ad13ec0e90646cdc5a55639f80070e1febbdcc2d36a72badfd.mp3",
        "audioSha256": "5ca014f4ea58b4ad13ec0e90646cdc5a55639f80070e1febbdcc2d36a72badfd"
      }
    },
    {
      "id": "7818d587-2954-43fc-95f0-5f0576b12f66:revise:23",
      "index": 23,
      "partId": "revolution-orbit-and-seasons",
      "question": {
        "display": "क्या summer, Sun के ज़्यादा पास होने से आती है?",
        "audioUrl": "/media/4cd5ea695ea988f618ef2afaa1aaecfc6188ef985514eea425f4c966d9bea769.mp3",
        "audioSha256": "4cd5ea695ea988f618ef2afaa1aaecfc6188ef985514eea425f4c966d9bea769"
      },
      "answer": {
        "display": "नहीं। India और Australia, Sun से बराबर दूरी पर हैं, लेकिन उनके seasons अलग-अलग होते हैं।",
        "audioUrl": "/media/fbebb6a5ac2f0bbd1ad3da15cddb7b5002ecec982a6c95d988e95ddac7ad03e0.mp3",
        "audioSha256": "fbebb6a5ac2f0bbd1ad3da15cddb7b5002ecec982a6c95d988e95ddac7ad03e0"
      }
    },
    {
      "id": "7818d587-2954-43fc-95f0-5f0576b12f66:revise:24",
      "index": 24,
      "partId": "revolution-orbit-and-seasons",
      "question": {
        "display": "India और Australia में seasons उल्टे क्यों होते हैं?",
        "audioUrl": "/media/9c724850778515698d30723e0f7ada52ff2fd57be4eca1b0aab58cb894435fa9.mp3",
        "audioSha256": "9c724850778515698d30723e0f7ada52ff2fd57be4eca1b0aab58cb894435fa9"
      },
      "answer": {
        "display": "Earth की axis के **tilt** की वजह से।",
        "audioUrl": "/media/5ce3be48ac23936ee382d6a1a5da53499650902d51fdc0624ff76e8e40db6cbd.mp3",
        "audioSha256": "5ce3be48ac23936ee382d6a1a5da53499650902d51fdc0624ff76e8e40db6cbd"
      }
    },
    {
      "id": "7818d587-2954-43fc-95f0-5f0576b12f66:revise:25",
      "index": 25,
      "partId": "revolution-orbit-and-seasons",
      "question": {
        "display": "Rotation हमें क्या देता है, और revolution क्या देता है?",
        "audioUrl": "/media/625dbde7154def4c4421fa96a65b1a2b3d66fd971cb8881418656d149ea70e01.mp3",
        "audioSha256": "625dbde7154def4c4421fa96a65b1a2b3d66fd971cb8881418656d149ea70e01"
      },
      "answer": {
        "display": "Rotation दिन और रात देता है, पर revolution और tilt, seasons देते हैं।",
        "audioUrl": "/media/f3673f49804f8477e4aa3ab71b440872eaa78ddf8bc9af786f9878451fbfeaf0.mp3",
        "audioSha256": "f3673f49804f8477e4aa3ab71b440872eaa78ddf8bc9af786f9878451fbfeaf0"
      }
    }
  ]
