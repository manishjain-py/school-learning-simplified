    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/client-sesv2": "3.1157.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
